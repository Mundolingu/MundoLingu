# Copy this file to ".env.local" and fill in your real values.
# Never commit .env.local to Git.

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (Developers -> API keys) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Optional: a Stripe coupon id for $5 off the first month (leave blank to skip)
STRIPE_FIRST_MONTH_COUPON=

# ---- Your site ----
# Use http://localhost:3000 locally; set to https://mundolingu.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Demo request form (Resend) ----
RESEND_API_KEY=re_xxx
DEMO_NOTIFY_EMAIL=mundolingu@gmail.com
# Optional (after you verify your domain in Resend):
# DEMO_FROM_EMAIL=MundoLingu <hello@mundolingu.com>

# ---- Optional: free website analytics (Cloudflare Web Analytics) ----
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-cloudflare-token
